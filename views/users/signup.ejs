<% layout("/layouts/boilerplate")-%>

<div class="row mt-3">
    <h1 class="offset-3">Signup on Wanderlust</h1>
    <div class="col-6 offset-3">
        
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input name="username" id="username" class="form-control" placeholder="enter username" type="text" required>
            <div class="valid-feedback">Looks Good</div>
            </div>
            <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input name="email" id="email" class="form-control" placeholder="enter username" type="email" required>
            <div class="valid-feedback">Looks Good</div>
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input name="password" id="password" class="form-control" placeholder="enter username" type="password" required>
            <div class="valid-feedback">Looks Good</div>
        </div>
        <button class="btn btn-success">Signup</button>
        </form>

    </div>
</div>